---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  inferSize?: boolean;
}

const {
  src,
  alt,
  width = undefined,
  height = undefined,
  class: className = "",
  inferSize = false
} = Astro.props;

const base = import.meta.env.BASE_URL || '/';
const baseUrl = base.endsWith('/') ? base : `${base}/`;

const isExternal = typeof src === 'string' && /^https?:\/\//i.test(src);
const isPublicPath = typeof src === 'string' && src.startsWith('/');

let resolvedSrc: string = src;
if (isPublicPath) {
  // Prefix the configured base path to absolute paths pointing into /public/.
  resolvedSrc = `${baseUrl}${src.replace(/^\/+/, '')}`;
}

const useWidth = width || 800;
const useHeight = height || 600;

// Plain <img> for /public/ assets and remote URLs (Astro's <Image> only
// optimizes imported assets). This preserves base path on GitHub Pages.
const usePlainImg = isExternal || isPublicPath;
---

<div class={`astro-image-container ${className}`}>
  {usePlainImg ? (
    <img src={resolvedSrc} alt={alt} class="astro-loaded-image" loading="lazy" />
  ) : inferSize ? (
    <Image
      src={resolvedSrc}
      alt={alt}
      inferSize={true}
      class="astro-loaded-image"
    />
  ) : (
    <Image
      src={resolvedSrc}
      alt={alt}
      width={useWidth}
      height={useHeight}
      class="astro-loaded-image"
    />
  )}
</div>

<style>
  .astro-image-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .astro-loaded-image {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>
